{
  "name": "dryrun-visualizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DryRun — an animated, step-by-step visualizer for every C++ program in this course.",
  "scripts": {
    "catalog": "node scripts/build-catalog.mjs",
    "dev": "npm run catalog && vite",
    "build": "npm run catalog && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run catalog && vitest run",
    "check": "npm run catalog && tsc --noEmit && vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
